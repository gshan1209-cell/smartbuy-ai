# SmartBuy AI backend development environment
DATABASE_URL=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# Existing Cloudflare R2 data lake settings
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PARQUET_PREFIX=history_parquet/agri_price/

# Recommendation cache: auto uses R2 when configured; use local only for local/test development.
# Render／正式環境必須設為 r2 並啟用 R2_REQUIRED，禁止退回暫存磁碟。
RECOMMENDATION_CACHE_BACKEND=auto
R2_REQUIRED=false
R2_RECOMMENDATION_PREFIX=recommendations/v2/
RECOMMENDATION_LOCAL_CACHE_DIR=.cache/recommendations
RECOMMENDATION_LOCK_TIMEOUT_SECONDS=150

# Optional OpenAI-compatible recommendation provider. Missing key uses rule fallback.
# A cache miss sends one request containing three prompt profiles: consumer, farmer, merchant.
RECOMMENDATION_LLM_PROVIDER=openai-compatible
RECOMMENDATION_LLM_BASE_URL=https://api.openai.com/v1
RECOMMENDATION_LLM_MODEL=gpt-4o-mini
RECOMMENDATION_LLM_API_KEY=
RECOMMENDATION_LLM_TIMEOUT_SECONDS=45
